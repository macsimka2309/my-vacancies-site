generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Заменён 26.08 по решению владельца: прежний набор описывал воронку найма
/// вообще, этот — нашу, где человека ведут до выхода на стажировку.
enum LeadStatus {
  IN_PROGRESS
  INTERVIEW_MOVED
  RESERVE
  REJECTED
  TO_INTERNSHIP
  INTERNSHIP_STARTED
  DEAL_CLOSED
  DUPLICATE
}

enum AdminRole {
  ADMIN
  MANAGER
  VACANCY_ADMIN
}

/// Период, за который назван совокупный доход. Смена считается отдельно.
enum SalaryPeriod {
  MONTH
  VAHTA
}

model Vacancy {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  project          String
  city             String
  workFormat       String        @map("work_format")
  /// Витринный текст зарплаты — то, что видит кандидат. Числа ниже
  /// выводятся из него при сохранении (lib/salary.ts) и нужны фильтру,
  /// микроразметке и выгрузке в агрегаторы.
  salary           String?
  salaryShiftMin   Int?          @map("salary_shift_min")
  salaryShiftMax   Int?          @map("salary_shift_max")
  /// Фактический средний доход за смену. Заполняется вручную, когда партнёр
  /// даёт цифру: вилка «1800–7000 ₽» читается кандидатом как обман.
  salaryShiftAvg   Int?          @map("salary_shift_avg")
  salaryPeriodMin  Int?          @map("salary_period_min")
  salaryPeriodMax  Int?          @map("salary_period_max")
  salaryPeriod     SalaryPeriod? @map("salary_period")
  /// Дата, до которой объявление действительно. Пусто — считается сама:
  /// updatedAt + 60 дней, см. lib/vacancy-validity.ts.
  validThrough     DateTime?     @map("valid_through") @db.Date
  schedule         String?
  responsibilities String        @db.Text
  requirements     String        @db.Text
  conditions       String        @db.Text
  address          String?
  contactComment   String?       @map("contact_comment") @db.Text
  isActive         Boolean       @default(true) @map("is_active")
  applications     Application[]
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([city])
  @@index([isActive])
  @@map("vacancies")
}

model Application {
  id                   String     @id @default(cuid())
  vacancyId            String     @map("vacancy_id")
  vacancy              Vacancy    @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  vacancyTitleSnapshot String     @map("vacancy_title_snapshot")
  projectSnapshot      String     @map("project_snapshot")
  candidateName        String     @map("candidate_name")
  phone                String
  normalizedPhone      String     @map("normalized_phone")
  city                 String?
  age                  Int?
  preferredContact     String?    @map("preferred_contact")
  telegramUsername     String?    @map("telegram_username")
  candidateComment     String?    @map("candidate_comment") @db.Text
  trafficSource        String?    @map("traffic_source")
  utmSource            String?    @map("utm_source")
  utmMedium            String?    @map("utm_medium")
  utmCampaign          String?    @map("utm_campaign")
  utmContent           String?    @map("utm_content")
  utmTerm              String?    @map("utm_term")
  /// ClientID Яндекс.Метрики — ключ для выгрузки офлайн-конверсий в Директ.
  ymClientId           String?    @map("ym_client_id")
  status               LeadStatus @default(IN_PROGRESS)
  responsibleManager   String?    @map("responsible_manager")
  managerComment       String?    @map("manager_comment") @db.Text
  personalDataConsentAt DateTime? @map("personal_data_consent_at")
  telegramSentAt       DateTime?  @map("telegram_sent_at")
  telegramError        String?    @map("telegram_error") @db.Text
  auditLogs             ApplicationAuditLog[]
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([normalizedPhone])
  @@index([status])
  @@index([vacancyId])
  @@map("applications")
}

/// Окна ограничителя частоты запросов. Раньше они жили в памяти процесса:
/// каждый перезапуск контейнера обнулял счётчики, а при нескольких репликах
/// защита формы исчезала — у каждой был свой счёт.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limits")
}

model AdminUser {
  id           String      @id @default(cuid())
  username     String      @unique
  fullName     String?     @map("full_name")
  passwordHash String      @map("password_hash")
  roles        AdminRole[] @default([MANAGER])
  isActive     Boolean     @default(true) @map("is_active")
  lastLoginAt  DateTime?   @map("last_login_at")
  auditLogs    ApplicationAuditLog[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("admin_users")
}

model ApplicationAuditLog {
  id                     String      @id @default(cuid())
  applicationId          String      @map("application_id")
  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  adminUserId            String      @map("admin_user_id")
  adminUser              AdminUser   @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  actorUsername           String      @map("actor_username")
  previousStatus         LeadStatus? @map("previous_status")
  newStatus              LeadStatus? @map("new_status")
  previousManagerComment String?     @map("previous_manager_comment") @db.Text
  newManagerComment      String?     @map("new_manager_comment") @db.Text
  /// Имя и город правятся руками: телефон дал только цифры, остальное
  /// менеджер узнаёт в разговоре. Без этих колонок правка города не
  /// попадала бы в журнал вовсе — а город это разрез всей отчётности.
  previousCandidateName  String?     @map("previous_candidate_name")
  newCandidateName       String?     @map("new_candidate_name")
  previousCity           String?     @map("previous_city")
  newCity                String?     @map("new_city")
  createdAt              DateTime    @default(now()) @map("created_at")

  @@index([applicationId])
  @@index([adminUserId])
  @@index([createdAt])
  @@map("application_audit_logs")
}
